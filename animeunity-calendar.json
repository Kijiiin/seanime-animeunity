{
  "id": "animeunity-calendar",
  "name": "AnimeUnity Calendar",
  "version": "0.2.0",
  "manifestURI": "https://raw.githubusercontent.com/Kijiiin/seanime-animeunity/refs/heads/main/animeunity-calendar.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Mostra in Seanime un calendario separato con gli episodi programmati su AnimeUnity.",
  "author": "USERNAME",
  "icon": "https://animeunity.co.it/favicon.ico",
  "website": "https://animeunity.co.it/calendario/",
  "readme": "https://github.com/USERNAME/AnimeUnity-Calendar",
  "notes": "Build iniziale sperimentale. Richiede il permesso di rete per animeunity.co.it e storage.",
  "lang": "it",
  "payloadURI": "https://raw.githubusercontent.com/Kijiiin/seanime-animeunity/refs/heads/main/animeunity-calendar.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "storage"
      ],
      "allow": {
        "networkAccess": {
          "allowedDomains": [
            "animeunity.co.it",
            "www.animeunity.co.it"
          ],
          "reasoning": "Serve esclusivamente per leggere la pagina pubblica del calendario AnimeUnity."
        }
      }
    }
  }
}
